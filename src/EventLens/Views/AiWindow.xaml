<ui:FluentWindow x:Class="EventLens.Views.AiWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Ask AI"
                 Width="760" Height="720" MinWidth="520" MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Title="Ask AI" />

        <!-- header -->
        <StackPanel Grid.Row="1" Margin="24,4,24,10">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Sparkle24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="HeaderText" Margin="10,0,0,0" FontSize="20" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="ProviderText" FontSize="12" Margin="32,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <Expander Header="What is sent to the AI" Margin="0,10,0,0">
                <TextBox x:Name="ContextBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180"
                         VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
            </Expander>
        </StackPanel>

        <!-- not configured -->
        <Border x:Name="SetupPanel" Grid.Row="2" Margin="24,0,24,12" CornerRadius="12" Padding="24" Visibility="Collapsed"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Connect an AI account first" FontSize="18" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="EventLens works with your own key. Groq is free (console.groq.com → API Keys); Ollama runs locally with no key. Your key is stored encrypted on this PC only." />
                <ui:Button Content="Open AI settings" Appearance="Primary" Click="OnOpenSettings">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Border>

        <!-- conversation -->
        <ScrollViewer x:Name="Scroller" Grid.Row="2" Margin="24,0,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Conversation" />
        </ScrollViewer>

        <!-- input -->
        <Grid Grid.Row="3" Margin="24,12,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="Input" PlaceholderText="Ask a follow-up question…" AcceptsReturn="False" KeyDown="OnInputKeyDown" />
            <ui:Button x:Name="SendButton" Grid.Column="1" Appearance="Primary" Margin="8,0,0,0" Click="OnSend" ToolTip="Send (Enter)">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Send24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Grid.Column="2" Margin="8,0,0,0" Click="OnCopyAll" ToolTip="Copy conversation">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>
    </Grid>
</ui:FluentWindow>
