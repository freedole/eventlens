<UserControl x:Class="EventLens.Views.EventDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:EventLens.Converters">
    <UserControl.Resources>
        <conv:SeverityToBrushConverter x:Key="SevBrush" />
        <conv:EventToBrushConverter x:Key="EvBrush" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="12" Padding="20"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <!-- badge + id -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border CornerRadius="10" Padding="9,2"
                                Background="{Binding Event, Converter={StaticResource EvBrush}, ConverterParameter=soft}">
                            <TextBlock Text="{Binding Event.SeverityText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding Event, Converter={StaticResource EvBrush}}" />
                        </Border>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="ID " /><Run Text="{Binding Event.Id, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" · " /><Run Text="{Binding Event.Explanation.Category, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding Event.Summary}" FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <Run Text="{Binding RelativeTime, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · " />
                        <Run Text="{Binding Event.TimeCreated, Mode=OneWay, StringFormat=F}" />
                        <LineBreak />
                        <Run Text="{Binding Event.Provider, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Event.LogName, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Event.MachineName, Mode=OneWay}" />
                    </TextBlock>

                    <!-- occurrences / history -->
                    <Border CornerRadius="8" Padding="10,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding OccurrenceText}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Padding="10,6" Margin="0,6,0,0" HorizontalAlignment="Left"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding HistoryText}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- explanation -->
                    <Border CornerRadius="8" Padding="14" Margin="0,16,0,0"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{Binding Event, Converter={StaticResource EvBrush}}" BorderThickness="3,0,0,0"
                            Visibility="{Binding Event.HasExplanation, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="What it means" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Event.Explanation.What}" TextWrapping="Wrap" />

                            <StackPanel Visibility="{Binding Event.Explanation.HasCauses, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                <TextBlock Text="Common causes" Style="{StaticResource Label}" />
                                <ItemsControl ItemsSource="{Binding Event.Explanation.Causes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" Margin="0,1"><Run Text="•  " /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding Event.Explanation.HasFix, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                <TextBlock Text="What to do" Style="{StaticResource Label}" />
                                <ItemsControl ItemsSource="{Binding Event.Explanation.Fix}" AlternationCount="20">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                           Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource PlusOne}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding Event.Explanation.HasRelated, Converter={StaticResource BoolToVis}}">
                                <Run Text="Related event IDs: " /><Run Text="{Binding Event.Explanation.RelatedText, Mode=OneWay}" />
                            </TextBlock>
                            <ui:Button Content="Learn more" Appearance="Transparent" Padding="0,6,0,0" Command="{Binding OpenLinkCommand}"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{Binding Event.Explanation.HasLink, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- decoded codes -->
                    <Border CornerRadius="8" Padding="14" Margin="0,12,0,0"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            Visibility="{Binding Event.Explanation.HasCodes, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <TextBlock Text="Codes in this event" Style="{StaticResource Label}" />
                            <ItemsControl ItemsSource="{Binding Event.Explanation.Codes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,2">
                                            <Run Text="{Binding Code, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                                            <Run Text="  " />
                                            <Run Text="{Binding Meaning, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- message -->
                    <Grid Margin="0,16,0,6">
                        <TextBlock Text="Original message" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="6,3" ToolTip="Copy message"
                                   Command="{Binding CopyMessageCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                    <TextBox Text="{Binding Event.Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" Background="Transparent" />

                    <!-- notes -->
                    <TextBlock Text="Your notes" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:Button Content="Save note" Padding="10,4" Command="{Binding SaveNoteCommand}" />
                        <TextBlock Text="{Binding NoteStatus}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- actions -->
            <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                <ui:Button Content="Ask AI" Appearance="Primary" Command="{Binding AskAiCommand}" Margin="0,0,6,6" Padding="10,5">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Sparkle24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="Copy" Command="{Binding CopyCommand}" Margin="0,0,6,6" Padding="10,5">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Copy24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="Around this" Command="{Binding AroundThisCommand}" Margin="0,0,6,6" Padding="10,5"
                           ToolTip="Everything that happened ±10 minutes around this event (Timeline)">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="History24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="All like this" Command="{Binding AllLikeThisCommand}" Margin="0,0,6,6" Padding="10,5">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Filter24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="Search online" Command="{Binding SearchOnlineCommand}" Margin="0,0,6,6" Padding="10,5">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Globe24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="{Binding MuteText}" Command="{Binding ToggleMuteCommand}" Margin="0,0,6,6" Padding="10,5"
                           ToolTip="Treat this event type as harmless: grey badge, not counted in scores, hidden by 'Hide harmless'">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="EyeOff24" />
                    </ui:Button.Icon>
                </ui:Button>
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
