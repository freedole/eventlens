<Page x:Class="EventLens.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,12,32,32" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />

            <ui:CardControl Margin="0,0,0,6" Header="Theme">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="DarkTheme24" />
                </ui:CardControl.Icon>
                <ComboBox Width="180" ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Shield24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Permissions" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AdminText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}" />
            </ui:CardControl>

            <!-- Knowledge base -->
            <TextBlock Text="Knowledge base" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,4" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Explanations work fully offline. Optionally, EventLens downloads a newer knowledge base from GitHub (once a day) - no data about your PC is sent." />
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="BookInformation24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Update knowledge base automatically" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding KnowledgeInfo}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding KbStatus}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Check now" Command="{Binding SyncKbCommand}" Margin="0,0,12,0" />
                    <ui:ToggleSwitch IsChecked="{Binding KbAutoUpdate}" />
                </StackPanel>
            </ui:CardControl>

            <!-- App updates -->
            <ui:CardControl Margin="0,0,0,6">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Tell me when a new version is available" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UpdateStatus}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <CheckBox Content="Include alpha/beta versions" IsChecked="{Binding IncludePrereleases}" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Check now" Command="{Binding CheckUpdateCommand}" Margin="0,0,12,0" />
                    <ui:ToggleSwitch IsChecked="{Binding CheckForUpdates}" />
                </StackPanel>
            </ui:CardControl>

            <!-- AI -->
            <TextBlock Text="AI assistant" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,4" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Optional. Use your own key - event text is sent only when you press Ask AI. Keys are encrypted for your Windows account (DPAPI)." />

            <Border CornerRadius="10" Padding="20" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Service" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ProviderNames}" SelectedIndex="{Binding ProviderIndex}" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="1" Text="API key" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="KeyInput" />
                            <ui:Button Grid.Column="1" Content="Save key" Margin="8,0,0,0" Click="OnSaveKey" />
                        </Grid>
                        <TextBlock Text="{Binding KeyHint}" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Model" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" PlaceholderText="{Binding ModelPlaceholder}"
                                Text="{Binding Model, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Grid.Row="3" Text="Endpoint" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" PlaceholderText="{Binding EndpointPlaceholder}"
                                Text="{Binding Endpoint, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Grid.Row="4" Text="Answer language" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding LanguageNames}" SelectedIndex="{Binding LanguageIndex}" Margin="0,0,0,12" />

                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="Test connection" Command="{Binding TestAiCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Sparkle24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="12,0,0,0"
                                         Visibility="{Binding AiBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding AiStatus}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Privacy & support -->
            <TextBlock Text="Privacy &amp; support" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8" />
            <ui:Card Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="Everything EventLens reads stays on this PC. Event text leaves your computer only when you press Ask AI, and only to the AI service you chose - you can always see exactly what is sent. History, notes and saved AI answers are stored locally in your profile." />
                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Content="Report an issue" Command="{Binding ReportIssueCommand}" Margin="0,0,8,6">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Bug24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="Open crash logs" Command="{Binding OpenLogsCommand}" Margin="0,0,8,6">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Folder24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,6" />
                        <ui:Button Content="Clear saved AI answers" Command="{Binding ClearAiCacheCommand}" Margin="0,0,8,6" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <!-- About -->
            <TextBlock Text="About" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8" />
            <ui:Card>
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <Run Text="EventLens " /><Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="The Event Viewer++ that explains itself." Margin="0,4,0,0" />
                    <TextBlock Text="{Binding KnowledgeInfo}" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink NavigateUri="https://github.com/freedole/eventlens" RequestNavigate="OnLink">github.com/freedole/eventlens</Hyperlink>
                    </TextBlock>
                    <TextBlock Text="MIT License · © 2026 Đorđe Kaurinović" FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
