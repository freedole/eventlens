<Page x:Class="EventLens.Views.ComparePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      x:Name="Root"
      Title="Compare">
    <Page.Resources>
        <!-- one column of results -->
        <DataTemplate x:Key="RowTemplate">
            <Button Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,8" Margin="0,0,0,4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Change}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                </Grid>
            </Button>
        </DataTemplate>
        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <Grid Margin="32,12,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Compare" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="What is new, gone, or happening more often than before. Great after an update, a new driver or a change on the network."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding Periods}" SelectedIndex="{Binding PeriodIndex}" Width="260" Margin="0,0,12,6" />
            <ui:ToggleSwitch Content="Include warnings" IsChecked="{Binding IncludeWarnings}" Margin="0,0,12,6" />
            <ui:Button Content="Refresh" Appearance="Primary" Command="{Binding RefreshCommand}" Margin="0,0,8,6">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="4,0,0,6" VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,12,16">
                    <TextBlock Style="{StaticResource ColumnTitle}"><Run Text="🆕 New in " /><Run Text="{Binding LabelA, Mode=OneWay}" /></TextBlock>
                    <ItemsControl ItemsSource="{Binding New}" ItemTemplate="{StaticResource RowTemplate}" />
                </StackPanel>
                <StackPanel Margin="12,0,0,16">
                    <TextBlock Style="{StaticResource ColumnTitle}" Text="↑ Happening more often" />
                    <ItemsControl ItemsSource="{Binding More}" ItemTemplate="{StaticResource RowTemplate}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,16">
                    <TextBlock Style="{StaticResource ColumnTitle}"><Run Text="✓ Gone (seen in " /><Run Text="{Binding LabelB, Mode=OneWay}" /><Run Text=" only)" /></TextBlock>
                    <ItemsControl ItemsSource="{Binding Gone}" ItemTemplate="{StaticResource RowTemplate}" />
                </StackPanel>
                <StackPanel Margin="12,0,0,16">
                    <TextBlock Style="{StaticResource ColumnTitle}" Text="↓ Happening less often" />
                    <ItemsControl ItemsSource="{Binding Less}" ItemTemplate="{StaticResource RowTemplate}" />
                </StackPanel>
            </UniformGrid>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
