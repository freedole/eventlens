<Page x:Class="EventLens.Views.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:EventLens.Converters"
      Title="Events">
    <Page.Resources>
        <conv:SeverityToBrushConverter x:Key="SevBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid Margin="32,16,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Events" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Logs}" SelectedIndex="{Binding LogIndex}" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Levels}" SelectedIndex="{Binding LevelIndex}" Margin="0,0,8,0" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding TimeWindows}" SelectedIndex="{Binding WindowIndex}" Margin="0,0,8,0" />
            <ui:TextBox Grid.Column="3" PlaceholderText="Search by ID, source or text…" Margin="0,0,8,0"
                        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <ui:Button Grid.Column="4" Appearance="Primary" Command="{Binding RefreshCommand}" ToolTip="Refresh">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- List + details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      CanUserReorderColumns="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="28" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="9" Height="9" HorizontalAlignment="Center"
                                         Fill="{Binding Severity, Converter={StaticResource SevBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat=g}" Width="140" SortMemberPath="TimeCreated" />
                    <DataGridTextColumn Header="Level" Binding="{Binding SeverityText}" Width="90" />
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="64" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Provider}" Width="200" />
                    <DataGridTextColumn Header="What happened" Binding="{Binding Summary}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Details -->
            <ui:Card Grid.Column="2" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Padding="20"
                     Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Selected}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border CornerRadius="4" Padding="8,2" Background="{Binding Severity, Converter={StaticResource SevBrush}}">
                                <TextBlock Text="{Binding SeverityText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="ID " /><Run Text="{Binding Id, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="{Binding Summary}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,16" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <Run Text="{Binding TimeCreated, Mode=OneWay, StringFormat=F}" />
                            <LineBreak />
                            <Run Text="{Binding Provider, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding LogName, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding MachineName, Mode=OneWay}" />
                        </TextBlock>

                        <!-- Explanation -->
                        <Border CornerRadius="6" Padding="14" Margin="0,0,0,16"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="3,0,0,0"
                                Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="What it means" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Explanation.What}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock Text="What to do" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Explanation.Action}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Original message" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0"
                                 Background="Transparent" />
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
        </Grid>

        <!-- Status bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
