<Page x:Class="EventLens.Views.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:EventLens.Converters"
      x:Name="Root"
      Title="Events">
    <Page.Resources>
        <conv:SeverityToBrushConverter x:Key="SevBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:SymbolConverter x:Key="Sym" />
        <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    </Page.Resources>

    <Grid Margin="32,12,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Margin="0,0,0,14">
            <TextBlock Text="Events" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="SemiBold" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12" Padding="10,4"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SourceText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Desktop24" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SourceText}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- filters -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding LogChoices}" DisplayMemberPath="Name" SelectedIndex="{Binding LogIndex}"
                      IsEnabled="{Binding IsNotFileSource}" Margin="0,0,8,0" ToolTip="Log" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Levels}" SelectedIndex="{Binding LevelIndex}" Margin="0,0,8,0" ToolTip="Level" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding TimeWindows}" SelectedIndex="{Binding WindowIndex}" Margin="0,0,8,0" ToolTip="Time" />
            <ui:TextBox Grid.Column="3" PlaceholderText="Search by ID, source or text…" Margin="0,0,12,0"
                        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <ui:ToggleSwitch Grid.Column="4" Content="Group repeats" IsChecked="{Binding GroupRepeats}" Margin="0,0,12,0"
                             ToolTip="Show identical events once with a count" />
            <ui:Button Grid.Column="5" Appearance="Primary" Command="{Binding RefreshCommand}" ToolTip="Refresh">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- quick filters -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding QuickFilters}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Button Appearance="Secondary" Margin="0,0,6,6" Padding="10,5"
                               Command="{Binding DataContext.QuickFilterCommand, ElementName=Root}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding Icon, Converter={StaticResource Sym}}" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </ui:Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- active filter banner -->
        <Border Grid.Row="3" CornerRadius="8" Padding="12,6" Margin="0,0,0,10" HorizontalAlignment="Left"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                Visibility="{Binding HasFilter, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Filter24" FontSize="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding FilterLabel}" Margin="8,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                <ui:Button Appearance="Transparent" Padding="4" Command="{Binding ClearFilterCommand}" ToolTip="Clear filter"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss16" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Border>

        <!-- list + details -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="EventGrid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="38"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      CanUserReorderColumns="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="8" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="4" CornerRadius="2" Margin="0,6" HorizontalAlignment="Left"
                                        Background="{Binding Severity, Converter={StaticResource SevBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat=g}" Width="140" SortMemberPath="TimeCreated" />
                    <DataGridTemplateColumn Header="Level" Width="96" SortMemberPath="Severity">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{Binding Severity, Converter={StaticResource SevBrush}, ConverterParameter=soft}">
                                    <TextBlock Text="{Binding SeverityText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Severity, Converter={StaticResource SevBrush}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="64" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Provider}" Width="190" />
                    <DataGridTextColumn Header="What happened" Binding="{Binding Summary}" Width="*" />
                    <DataGridTemplateColumn Header="" Width="60" SortMemberPath="Count">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="7,1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- details -->
            <Border Grid.Column="2" CornerRadius="12" Padding="20"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" DataContext="{Binding SelectedEvent}">
                                <Border CornerRadius="10" Padding="9,2"
                                        Background="{Binding Severity, Converter={StaticResource SevBrush}, ConverterParameter=soft}">
                                    <TextBlock Text="{Binding SeverityText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Severity, Converter={StaticResource SevBrush}}" />
                                </Border>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="ID " /><Run Text="{Binding Id, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedEvent.Summary}" FontFamily="{StaticResource Display}"
                                       FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" DataContext="{Binding SelectedEvent}">
                                <Run Text="{Binding TimeCreated, Mode=OneWay, StringFormat=F}" />
                                <LineBreak />
                                <Run Text="{Binding Provider, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding LogName, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding MachineName, Mode=OneWay}" />
                            </TextBlock>

                            <Border CornerRadius="8" Padding="10,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    Visibility="{Binding Selected.IsGroup, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Selected.OccurrenceText}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- explanation -->
                            <Border CornerRadius="8" Padding="14" Margin="0,16,0,16"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="3,0,0,0"
                                    Visibility="{Binding SelectedEvent.HasExplanation, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="What it means" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SelectedEvent.Explanation.What}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <TextBlock Text="What to do" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SelectedEvent.Explanation.Action}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Original message" FontWeight="SemiBold" Margin="0,12,0,6" />
                            <TextBox Text="{Binding SelectedEvent.Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0"
                                     Background="Transparent" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- actions -->
                    <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                        <ui:Button Content="Ask AI" Appearance="Primary" Command="{Binding AskAiCommand}" Margin="0,0,6,6">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Sparkle24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="Copy" Command="{Binding CopyCommand}" Margin="0,0,6,6">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="Search online" Command="{Binding SearchOnlineCommand}" Margin="0,0,6,6">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Globe24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="All like this" Command="{Binding FilterSimilarCommand}" Margin="0,0,6,6">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Filter24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- status -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
