<Page x:Class="EventLens.Views.TimelinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:EventLens.Converters"
      xmlns:views="clr-namespace:EventLens.Views"
      x:Name="Root"
      Title="Timeline">
    <Page.Resources>
        <conv:EventToBrushConverter x:Key="EvBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid Margin="32,12,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="What happened at…" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Every log (System, Application, Security, Defender, Windows Update, Remote Desktop…) on one time line around a moment."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <DatePicker SelectedDate="{Binding Date}" Width="160" Margin="0,0,8,6" />
            <ui:TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,8,6" PlaceholderText="14:30" KeyDown="OnTimeKeyDown" />
            <ComboBox ItemsSource="{Binding Spans}" SelectedIndex="{Binding SpanIndex}" Width="150" Margin="0,0,8,6" />
            <ui:Button Content="Show" Appearance="Primary" Command="{Binding ShowCommand}" Margin="0,0,8,6">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="History24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Content="Now" Command="{Binding NowCommand}" Margin="0,0,16,6" />
            <ui:ToggleSwitch Content="Include information" IsChecked="{Binding IncludeInfo}" Margin="0,0,12,6" />
            <ui:ToggleSwitch Content="Hide harmless" IsChecked="{Binding HideHarmless}" Margin="0,0,12,6" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Event.TimeCreated, StringFormat='HH:mm:ss'}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Offset}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Border Grid.Column="2" Width="4" CornerRadius="2" Margin="0,3" Background="{Binding Event, Converter={StaticResource EvBrush}}" />
                            <Border Grid.Column="3" CornerRadius="8" Padding="6,1" Margin="8,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock Text="{Binding LogShort}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                            </Border>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{Binding Event.Summary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Event.Provider, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Event.Id, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding Event.SeverityText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <views:EventDetailView Grid.Column="2" DataContext="{Binding Detail}"
                                   Visibility="{Binding DataContext.Detail, ElementName=Root, Converter={StaticResource NullToVis}}" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
