<Page x:Class="EventLens.Views.FindingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:EventLens.Converters"
      x:Name="Root"
      Title="Findings">
    <Page.Resources>
        <conv:FindingToBrushConverter x:Key="FBrush" />
        <conv:SymbolConverter x:Key="Sym" />
        <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
        <Style x:Key="Surface" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,12,32,32" MaxWidth="1200">
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Findings" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Problems on this computer in the last 30 days, worked out offline from the event logs."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Content="Refresh" Appearance="Primary" Command="{Binding RefreshCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- all clear -->
            <Border Style="{StaticResource Surface}" Visibility="{Binding IsClean, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="28" Foreground="#4CC26E" />
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="No problems found" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="No crashes, disk errors, failed updates or security issues worth your attention." Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- findings -->
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Surface}" Margin="0,0,0,10" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="12,0,0,12" Background="{Binding Severity, Converter={StaticResource FBrush}}" />
                                <Grid Grid.Column="1" Margin="18,16,18,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top"
                                            Background="{Binding Severity, Converter={StaticResource FBrush}, ConverterParameter=soft}">
                                        <ui:SymbolIcon Symbol="{Binding Icon, Converter={StaticResource Sym}}" FontSize="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding Severity, Converter={StaticResource FBrush}}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Details}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <Run Text="•  " /><Run Text="{Binding Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding HistoryText}" FontSize="12" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}" />
                                        <Border CornerRadius="6" Padding="8,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                                <Run Text="Your note: " FontWeight="SemiBold" /><Run Text="{Binding Note, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>

                                        <!-- expanded: what to do + note editor -->
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding Expanded, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="What to do" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding Fix}" AlternationCount="20">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                       Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource PlusOne}}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Your notes" FontWeight="SemiBold" Margin="0,12,0,4" />
                                            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <ui:Button Content="Save note" Padding="10,4" Command="{Binding SaveNoteCommand}" />
                                                <TextBlock Text="{Binding NoteStatus}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" MinWidth="150">
                                        <ui:Button Content="What to do" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                   Command="{Binding DataContext.ToggleCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Lightbulb24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="Events" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                   Command="{Binding DataContext.OpenEventsCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="List24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="Last time" HorizontalAlignment="Stretch" Margin="0,0,0,6" ToolTip="Timeline around the last occurrence"
                                                   Command="{Binding DataContext.TimelineCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="History24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="Ask AI" HorizontalAlignment="Stretch"
                                                   Command="{Binding DataContext.AskAiCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Sparkle24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- resolved -->
            <StackPanel Visibility="{Binding HasResolved, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                <TextBlock Text="Not seen in the last 7 days" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="Problems EventLens remembers from earlier checks that have stopped appearing." Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding Resolved}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Surface}" Padding="16,10" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="#4CC26E" />
                                        <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                        <Run Text="last seen " /><Run Text="{Binding LastSeen, Mode=OneWay, StringFormat='d MMM yyyy'}" />
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding Status}" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
