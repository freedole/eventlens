<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EventLens</RootNamespace>
    <AssemblyName>EventLens</AssemblyName>
    <Version>0.2.0</Version>
    <Product>EventLens</Product>
    <Company>freedole</Company>
    <Authors>Đorđe Kaurinović</Authors>
    <Description>EventLens - the Event Viewer++ that explains itself.</Description>
    <Copyright>© 2026 Đorđe Kaurinović</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\eventlens.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\eventlens.ico" />
    <Resource Include="Assets\eventlens-32.png" />
    <EmbeddedResource Include="..\..\knowledge\*.json" LogicalName="kb.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
